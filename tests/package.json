{
  "name": "greenmart-tests",
  "version": "1.0.0",
  "description": "GreenMart – Bộ kiểm thử: Postman/Newman, k6, Playwright (SV08)",
  "private": true,
  "scripts": {
    "test:api": "newman run api/greenmart.postman_collection.json -e api/environment.local.json --reporters cli,htmlextra --reporter-htmlextra-export ../docs/testing/newman-report.html",
    "test:api:ci": "newman run api/greenmart.postman_collection.json -e api/environment.json --reporters cli,json --reporter-json-export ../docs/testing/newman-report.json",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:headed": "cd e2e && npx playwright test --headed",
    "install:e2e": "cd e2e && npm install && npx playwright install chromium"
  },
  "devDependencies": {
    "newman": "6.2.1",
    "newman-reporter-htmlextra": "1.23.1",
    "@playwright/test": "1.49.0"
  }
}
