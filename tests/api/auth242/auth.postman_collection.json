              "pm.test('TC-AUTH01-11 rotate refresh: HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json();pm.test('Refresh rotated',()=>pm.expect(d.refreshToken).not.to.eql(pm.collectionVariables.get('oldRefresh')));pm.collectionVariables.set('cashierAccess',d.accessToken);pm.collectionVariables.set('cashierRefresh',d.refreshToken);}"
            ]
          }
        }
      ]
