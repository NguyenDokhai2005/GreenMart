        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-AUTH01-40 me branch scope: HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('CASHIER GM001 only',()=>{const d=pm.response.json();pm.expect(d.role).to.eql('CASHIER');pm.expect(d.branches.map(b=>b.id)).to.eql([1]);});"
            ]
          }
        }
      ]
    },
