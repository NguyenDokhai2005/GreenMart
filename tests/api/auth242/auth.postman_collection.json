{
  "info": {
    "name": "GreenMart AUTH RBAC core #242",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Core real API auth/RBAC checks; full 65-case evidence comes from check_api.py. No database mutation, reset, or raw token artifacts."
  },
  "item": [
    {
      "name": "TC-AUTH01-30 missing token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-AUTH01-30 missing token: HTTP 401',()=>pm.response.to.have.status(401));",
              "pm.test('TC-AUTH01-30 missing token: error envelope',()=>{const d=pm.response.json();pm.expect(d.code).to.eql('UNAUTHORIZED');pm.expect(d.traceId).to.be.a('string').and.not.empty;pm.expect(d).not.to.have.property('stackTrace');});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-AUTH01-01 login cashier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"thungan.gm001\", \"password\": \"{{demoPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-AUTH01-01 login cashier: HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const d=pm.response.json();pm.collectionVariables.set('cashierAccess',d.accessToken);pm.collectionVariables.set('oldRefresh',d.refreshToken);pm.test('TokenResponse and no password fields',()=>{pm.expect(d.tokenType).to.eql('Bearer');pm.expect(d.expiresIn).to.eql(900);pm.expect(d.user.role).to.eql('CASHIER');pm.expect(JSON.stringify(d)).not.to.match(/passwordHash|password_hash|\"password\"/);});}"
            ]
          }
        }
      ]
    },
    {
