' Toàn bộ thực thể và quan hệ của CSDL GreenMart (khớp mục 7 SRS v1.0)
' Ký hiệu: * = bắt buộc (NOT NULL), <<PK>> khóa chính, <<FK>> khóa ngoại, <<UQ>> duy nhất
' Tag: $core dùng chung, $sales bán hàng, $stock kho, $ops tích hợp/hệ thống/dự báo

skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #5C6360
skinparam class {
  BackgroundColor #FFFDF8
  BorderColor #2F7D5B
  HeaderBackgroundColor #E7F1EB
  FontColor #16302B
  AttributeFontColor #2B3A35
}
skinparam package {
  BorderColor #8A8F8C
  FontColor #16302B
}
hide circle
hide methods
hide stereotype

package "Danh mục và tổ chức" {
  entity "branch\nChi nhánh" as branch $core $sales $stock $ops {
    * id : BIGINT <<PK>>
    --
    * code : VARCHAR(20) <<UQ>>
    * name : VARCHAR(120)
    address : VARCHAR(255)
    * is_active : BOOLEAN
  }
  entity "category\nDanh mục" as category $core $sales {
    * id : BIGINT <<PK>>
    --
    * name : VARCHAR(120)
    parent_id : BIGINT <<FK>>
  }
  entity "product\nSản phẩm" as product $core $sales $stock $ops {
    * id : BIGINT <<PK>>
    --
    * sku : VARCHAR(40) <<UQ>>
    barcode : VARCHAR(40)
    * name : VARCHAR(200)
    * unit : VARCHAR(20)
    * category_id : BIGINT <<FK>>
    * sale_price : BIGINT (VND, ≥ 0)
    * cost_price : BIGINT (VND, ≥ 0)
    * is_active : BOOLEAN
  }
}

package "Người dùng và phân quyền" {
  entity "app_user\nNgười dùng" as app_user $core $stock $ops {
    * id : BIGINT <<PK>>
    --
    * username : VARCHAR(60) <<UQ>>
    * password_hash : VARCHAR(100)
    * full_name : VARCHAR(120)
    * role : ADMIN | OWNER | BRANCH_MANAGER\n| CASHIER | STOREKEEPER
    * is_active : BOOLEAN
    failed_login_count : INT
    locked_until : TIMESTAMPTZ
  }
  entity "user_branch\nGán chi nhánh" as user_branch $core {
    * user_id : BIGINT <<PK, FK>>
    * branch_id : BIGINT <<PK, FK>>
  }
  entity "audit_log\nNhật ký thao tác" as audit_log $ops {
    * id : BIGINT <<PK>>
    --
    user_id : BIGINT <<FK>>
    * action : VARCHAR(60)
    * entity : VARCHAR(60)
    entity_id : VARCHAR(60)
    detail : JSONB
    * created_at : TIMESTAMPTZ
    .. chỉ INSERT ..
  }
}

package "Bán hàng" {
  entity "customer\nKhách hàng" as customer $sales {
    * id : BIGINT <<PK>>
    --
    * phone : VARCHAR(15) <<UQ>>
    * name : VARCHAR(120)
    email : VARCHAR(120)
    * created_at : TIMESTAMPTZ
  }
  entity "promotion\nKhuyến mại" as promotion $sales {
    * id : BIGINT <<PK>>
    --
    * code : VARCHAR(30) <<UQ>>
    * type : PERCENT | AMOUNT
    * level : ORDER | ITEM
    * value : BIGINT
    max_discount : BIGINT
    min_order : BIGINT
    * start_at : TIMESTAMPTZ
    * end_at : TIMESTAMPTZ (> start_at)
    usage_limit : INT
    * used_count : INT (≤ usage_limit)
    * status : DRAFT | ACTIVE | PAUSED | ENDED
  }
  entity "promotion_product\nSản phẩm áp KM" as promotion_product $sales {
    * promotion_id : BIGINT <<PK, FK>>
    * product_id : BIGINT <<PK, FK>>
  }
  entity "promotion_branch\nChi nhánh áp KM" as promotion_branch $sales {
    * promotion_id : BIGINT <<PK, FK>>
    * branch_id : BIGINT <<PK, FK>>
  }
  entity "promotion_channel\nKênh áp KM" as promotion_channel $sales {
    * promotion_id : BIGINT <<PK, FK>>
    * channel_id : BIGINT <<PK, FK>>
  }
  entity "sales_order\nĐơn hàng" as sales_order $sales $ops {
    * id : BIGINT <<PK>>
    --
    * code : VARCHAR(30) <<UQ>>
    * channel_id : BIGINT <<FK>>
    external_order_id : VARCHAR(60)
    * branch_id : BIGINT <<FK>>
    customer_id : BIGINT <<FK>>
    promotion_id : BIGINT <<FK>> (KM cấp đơn)
    * status : NEW | RESERVED | CONFIRMED | COMPLETED\n| CANCELLED | EXPIRED | REJECTED | RETURNED
    * subtotal : BIGINT
    * discount : BIGINT
    * total : BIGINT
    reserved_until : TIMESTAMPTZ
    created_by : BIGINT <<FK>>
    * created_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ
    .. UQ (channel_id, external_order_id) ..
  }
  entity "order_item\nDòng đơn" as order_item $sales {
    * id : BIGINT <<PK>>
    --
    * order_id : BIGINT <<FK>>
    * product_id : BIGINT <<FK>>
    * quantity : INT (> 0)
    * unit_price : BIGINT (giá chụp lúc bán)
    * discount : BIGINT
    * line_total : BIGINT
    promotion_id : BIGINT <<FK>> (KM cấp dòng)
  }
  entity "payment\nThanh toán" as payment $sales {
    * id : BIGINT <<PK>>
    --
    * order_id : BIGINT <<FK>>
    * method : CASH | CARD | QR
    * amount : BIGINT
    * status : PENDING | PAID | FAILED | REFUNDED
    provider_ref : VARCHAR(60)
    paid_at : TIMESTAMPTZ
  }
  entity "return_document\nPhiếu trả hàng" as return_document $sales {
    * id : BIGINT <<PK>>
    --
    * code : VARCHAR(30) <<UQ>>
    * order_id : BIGINT <<FK>>
    * branch_id : BIGINT <<FK>> (chi nhánh nhận trả)
    * reason : VARCHAR(255)
    * refund_amount : BIGINT
    * status : DRAFT | APPROVED | CANCELLED
    * created_by : BIGINT <<FK>>
    approved_by : BIGINT <<FK>> (≠ created_by)
    * created_at : TIMESTAMPTZ
    approved_at : TIMESTAMPTZ (ngày trả, BR-18)
  }
  entity "return_item\nDòng trả hàng" as return_item $sales {
    * id : BIGINT <<PK>>
    --
    * return_id : BIGINT <<FK>>
    * order_item_id : BIGINT <<FK>>
    * quantity : INT (≤ số đã mua)
    * condition : RESELLABLE | DAMAGED
  }
}

package "Kho" {
  entity "inventory\nTồn kho" as inventory $stock $ops {
    * branch_id : BIGINT <<PK, FK>>
    * product_id : BIGINT <<PK, FK>>
    --
    * on_hand : INT (≥ 0)
    * reserved : INT (≥ 0, ≤ on_hand)
    reorder_point : INT
    * version : BIGINT
    * updated_at : TIMESTAMPTZ
  }
  entity "inventory_transaction\nSổ giao dịch kho" as inv_tx $stock {
    * id : BIGINT <<PK>>
    --
    * branch_id : BIGINT <<FK>>
    * product_id : BIGINT <<FK>>
    * type : IMPORT | EXPORT | SALE | RESERVE | RELEASE\n| RETURN | TRANSFER_OUT | TRANSFER_IN | ADJUST
    * delta_on_hand : INT (±, = 0 khi RESERVE/RELEASE)
    * on_hand_after : INT (≥ 0)
    * delta_reserved : INT (±, = 0 khi IMPORT/EXPORT/ADJUST)
    * reserved_after : INT (≥ 0)
    * ref_type : VARCHAR(30)
    * ref_id : BIGINT
    created_by : BIGINT <<FK>>
    * created_at : TIMESTAMPTZ
    .. chỉ INSERT ..
  }
  entity "stock_document\nPhiếu kho" as stock_doc $stock {
    * id : BIGINT <<PK>>
    --
    * code : VARCHAR(30) <<UQ>>
    * type : IMPORT | EXPORT | TRANSFER | ADJUST
    * branch_id : BIGINT <<FK>>
    to_branch_id : BIGINT <<FK>> (chuyển kho)
    * status : DRAFT | APPROVED | IN_TRANSIT\n| RECEIVED | CANCELLED
    supplier : VARCHAR(120)
    reason : VARCHAR(255)
    * created_by : BIGINT <<FK>>
    approved_by : BIGINT <<FK>> (≠ created_by)
    received_by : BIGINT <<FK>>
    * created_at : TIMESTAMPTZ
    approved_at : TIMESTAMPTZ (tồn thay đổi tại đây)
    received_at : TIMESTAMPTZ (chuyển kho)
  }
  entity "stock_document_item\nDòng phiếu kho" as stock_item $stock {
    * id : BIGINT <<PK>>
    --
    * document_id : BIGINT <<FK>>
    * product_id : BIGINT <<FK>>
    * quantity : INT
    received_quantity : INT (chuyển kho)
    counted_quantity : INT (kiểm kê)
    unit_cost : BIGINT (nhập hàng)
  }
}

package "Tích hợp kênh" {
  entity "sales_channel\nKênh bán" as channel $sales $ops {
    * id : BIGINT <<PK>>
    --
    * code : POS | WEB | MARKET <<UQ>>
    * name : VARCHAR(60)
    default_branch_id : BIGINT <<FK>>
    webhook_secret : VARCHAR(100)
    * safety_stock : INT (mặc định 2)
  }
  entity "channel_branch\nChi nhánh phục vụ kênh" as channel_branch $ops {
    * channel_id : BIGINT <<PK, FK>>
    * branch_id : BIGINT <<PK, FK>>
  }
  entity "channel_product\nÁnh xạ SKU kênh" as channel_product $ops {
    * channel_id : BIGINT <<PK, FK>>
    * product_id : BIGINT <<PK, FK>>
    --
    * external_sku : VARCHAR(60)
    .. UQ (channel_id, external_sku) ..
  }
  entity "outbox_event\nSự kiện chờ gửi" as outbox $ops {
    * id : BIGINT <<PK>>
    --
    * aggregate_type : VARCHAR(40)
    * aggregate_id : VARCHAR(60)
    * event_type : VARCHAR(60)
    * payload : JSONB
    * status : PENDING | SENT | FAILED
    * attempts : INT
    * created_at : TIMESTAMPTZ
  }
  entity "sync_log\nNhật ký đồng bộ" as sync_log $ops {
    * id : BIGINT <<PK>>
    --
    * channel_id : BIGINT <<FK>>
    * direction : IN | OUT
    external_id : VARCHAR(60)
    * status : SUCCESS | RETRYING | FAILED
    error : TEXT
    * attempts : INT
    * created_at : TIMESTAMPTZ
  }
}

package "Dự báo (do forecast-service sở hữu)" {
  entity "daily_sales\nDoanh số ngày" as daily_sales $ops {
    * sale_date : DATE <<PK>>
    * branch_id : BIGINT <<PK, FK>>
    * product_id : BIGINT <<PK, FK>>
    --
    * qty_sold : INT
    * qty_returned : INT
    * qty_net : INT
    * revenue : BIGINT
    * promo_flag : BOOLEAN
    * promo_discount_pct : NUMERIC(5,2)
    * stockout : BOOLEAN
  }
  entity "forecast_run\nLần chạy dự báo" as forecast_run $ops {
    * id : BIGINT <<PK>>
    --
    * started_at : TIMESTAMPTZ
    finished_at : TIMESTAMPTZ
    * status : RUNNING | DONE | FAILED
    * model_version : VARCHAR(40)
    mae : NUMERIC
    wape : NUMERIC
    baseline_mae : NUMERIC
    baseline_wape : NUMERIC
  }
  entity "forecast_result\nKết quả dự báo" as forecast_result $ops {
    * id : BIGINT <<PK>>
    --
    * run_id : BIGINT <<FK>>
    * branch_id : BIGINT <<FK>>
    * product_id : BIGINT <<FK>>
    * horizon : 7 | 30
    * target_date : DATE
    * predicted_qty : NUMERIC
  }
}

' ---------- Quan hệ ----------
category |o--o{ category : cha–con
category ||--o{ product
app_user ||--o{ user_branch
branch ||--o{ user_branch
app_user |o--o{ audit_log

customer |o--o{ sales_order
branch ||--o{ sales_order
channel ||--o{ sales_order
app_user |o--o{ sales_order : tạo
promotion |o--o{ sales_order : KM cấp đơn
sales_order ||--|{ order_item
product ||--o{ order_item
promotion |o--o{ order_item : KM cấp dòng
sales_order ||--o{ payment
sales_order ||--o{ return_document
return_document ||--|{ return_item
order_item ||--o{ return_item
branch ||--o{ return_document
promotion ||--o{ promotion_product
product ||--o{ promotion_product
promotion ||--o{ promotion_branch
branch ||--o{ promotion_branch
promotion ||--o{ promotion_channel
channel ||--o{ promotion_channel

branch ||--o{ inventory
product ||--o{ inventory
branch ||--o{ inv_tx
product ||--o{ inv_tx
app_user |o--o{ inv_tx
branch ||--o{ stock_doc : chi nhánh nguồn
branch |o--o{ stock_doc : chi nhánh đích
app_user ||--o{ stock_doc : lập / duyệt
stock_doc ||--|{ stock_item
product ||--o{ stock_item

branch |o--o{ channel : mặc định
channel ||--o{ channel_branch
branch ||--o{ channel_branch
channel ||--o{ channel_product
product ||--o{ channel_product
channel ||--o{ sync_log

branch ||--o{ daily_sales
product ||--o{ daily_sales
forecast_run ||--o{ forecast_result
branch ||--o{ forecast_result
product ||--o{ forecast_result
