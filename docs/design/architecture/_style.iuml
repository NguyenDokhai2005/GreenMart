' Kiểu dùng chung cho sơ đồ kiến trúc GreenMart
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #5C6360
skinparam ArrowFontSize 10
skinparam ArrowFontColor #3E4542
skinparam nodesep 60
skinparam ranksep 70
skinparam rectangle {
  BorderColor #16302B
  FontStyle bold
}
skinparam component {
  BackgroundColor #F6F4EE
  BorderColor #2F7D5B
  FontColor #16302B
}
skinparam database {
  BackgroundColor #FFFDF8
  BorderColor #2F7D5B
}
skinparam queue {
  BackgroundColor #FFFDF8
  BorderColor #2F7D5B
}
skinparam actorBorderColor #16302B
skinparam actorBackgroundColor #FFFFFF
skinparam note {
  BackgroundColor #FBEDE3
  BorderColor #B5541C
  FontSize 10
}
