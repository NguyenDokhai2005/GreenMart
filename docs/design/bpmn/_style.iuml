' Kiểu dùng chung cho sơ đồ quy trình (BPMN) GreenMart
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #5C6360
skinparam ArrowFontSize 11
skinparam ArrowFontColor #5C6360
skinparam swimlaneBorderColor #16302B
skinparam swimlaneTitleFontStyle bold
skinparam activity {
  BackgroundColor #F6F4EE
  BorderColor #2F7D5B
  FontColor #16302B
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #B5541C
  StartColor #2F7D5B
  EndColor #16302B
}
skinparam note {
  BackgroundColor #FBEDE3
  BorderColor #B5541C
  FontSize 11
}
skinparam partition {
  BorderColor #2F7D5B
}
