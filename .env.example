# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
POSTGRES_DB=greenmart
POSTGRES_USER=greenmart
POSTGRES_PASSWORD=change-me
FORECAST_DB_USER=forecast_ro
FORECAST_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=greenmart
RABBITMQ_DEFAULT_PASS=change-me
JWT_SECRET=change-me-to-a-long-random-string
CHANNEL_WEB_SECRET=change-me
CHANNEL_MARKET_SECRET=change-me
# Hostnames below are Docker Compose service names.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/greenmart
SPRING_DATA_REDIS_HOST=redis
SPRING_RABBITMQ_HOST=rabbitmq
MOCK_CONNECTOR_URL=http://mock-connector:4000
# Optional JVM flags, for example -Xmx512m; Java reads this variable directly.
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Ho_Chi_Minh
