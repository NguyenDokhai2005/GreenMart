{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "tests/layouts/operations/menuConfig.test.ts",
    "tests/layouts/operations/OperationsScope.test.tsx",
    "tests/features/dashboard/revenue.test.ts",
    "tests/features/inventory/InventoryPage.test.tsx",
    "tests/features/inventory/inventoryQuery.test.ts",
    "tests/features/inventory/pagination.test.ts",
    "tests/features/inventory/useDebouncedCallback.test.ts"
  ]
}
